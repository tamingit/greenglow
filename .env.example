# Copy to .env (gitignored) and fill in. Never commit real host names.
# Read by the server in Development (npm run dev) and by `docker compose`.
# Settings use ASP.NET Core names: Section__Key. Commented lines show the default.

# ── Sign-in ──────────────────────────────────────────────────────────────────
# Entra ID: an app registration whose redirect URI is the address the browser uses plus
# /auth/callback (http://localhost:5173/auth/callback under npm run dev), with the Microsoft
# Graph application permissions User.ReadBasic.All and GroupMember.Read.All.
# Entra__TenantId=00000000-0000-0000-0000-000000000000
# Entra__ClientId=00000000-0000-0000-0000-000000000000
# Entra__ClientSecret=
# The first administrator (more are added in the admin page).
# Entra__InitialAdminUpn=someone@example.com
# Without Entra ID, npm run dev uses a dev login that accepts any UPN (Development only).
Auth__DevLogin=true
# How long a sign-in lasts without activity.
# Auth__SessionHours=12

# ── Public demo (compose.demo.yaml sets these) ──────────────────────────────
# Guests without accounts, demo systems only ("isDemo": true), no sharing or administration.
# Refused with Entra ID, the dev login or an initial administrator.
# Demo__Enabled=false
# How long a guest's sign-in lasts, and how many guests one address may start per hour.
# Demo__GuestHours=8
# Demo__GuestsPerHour=10

# ── Server ───────────────────────────────────────────────────────────────────
# docker compose: the port the container listens and is published on.
# GREENGLOW_PORT=8080
# The address people use. Its origin may open sessions; share links are built on it.
# Server__PublicUrl=http://localhost:5080
# More origins allowed to open sessions (npm run dev adds http://localhost:5173 itself).
# Server__AllowedOrigins__0=
# Behind a TLS proxy: take the client address and scheme from X-Forwarded-*.
# Server__TrustForwardedHeaders=false
# The SQLite database (settings, users, connections, log, shares) and the sign-in keys.
# Data__DbPath=data/greenglow.db

# ── Sessions ─────────────────────────────────────────────────────────────────
# Defaults: an administrator can change them, and the value saved in the database wins.
Sessions__MaxFrontends=2
Sessions__IdleMinutes=5
Sessions__MaxConnections=50

# ── IBM i systems ────────────────────────────────────────────────────────────
# Seeded into the database on first start: a JSON file (copy
# config/connections.example.json to config/connections.json) or the same JSON inline in
# Seed__ConnectionsJson. Each entry has its own per-user session limit and access.
Seed__ConnectionsFile=config/connections.json
# Seed__ConnectionsJson=

# The CA that issued the IBM i certificate, for tls:// connections: a PEM file, or the PEM
# text itself in Relay__CaPem (one line is fine). With neither, tls:// connections accept
# any certificate: still encrypted, but the IBM i isn't verified (the server warns, and the
# page shows "TLS, unverified").
Relay__CaFile=certs/ibmi-ca.pem
# Relay__CaPem=

# ── Development and tests only ───────────────────────────────────────────────
# Capture tool (npm run capture). Targets it may connect to (test systems only; the
# address comes from the server's database, or from --url) and the device it requests:
# GG, then a node number and 3 digits, one no GreenGlow server hands out (say node 9's last).
CAPTURE_TARGETS=test
CAPTURE_DEVICE=GG9999
# Groups for the stand-in directory used with the dev login ("*" means everyone):
# Dev__Groups=Developers=someone@example.com;other@example.com,Everyone=*
# This server's node number (1 to 9), in its device names (GG<node><number>). Use one no other
# GreenGlow reaching the same IBM i uses (production's nodes, the test instance):
# Cluster__NodeId=9

# The browser tests (npm run e2e) don't read this file. For the live tests against a real
# test system, set E2E_IBMI_TARGET, E2E_IBMI_USER, E2E_IBMI_PASSWORD (and optionally
# E2E_IBMI_NODE, E2E_IBMI_CA_PEM) in the shell, so the password isn't kept in a file.
