# dependencies and build output
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
*.timestamp-*.mjs

# local environment and certificates (never commit hostnames, profiles or certs)
.env
.env.*
!.env.example
certs/

# raw session recordings may contain passwords and business data
test/recordings/

# logs
*.log

# editor and OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# .NET build output
bin/
obj/
TestResults/

# local SQLite database (npm run dev). Ignored by file type, not by a "data/" folder rule:
# where letter case is ignored, that rule also hides the server's source folder Data/.
*.db
*.db-shm
*.db-wal
/data/

# Playwright output
test-results/

# real connection seed (host names)
config/connections.json
